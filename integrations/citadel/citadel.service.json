{
  "schemaVersion": 1,
  "id": "luna",
  "displayName": "Luna",
  "description": "Persistent Pi conversations for Apple devices and the web",
  "workingDirectory": "../..",
  "command": ["./target/release/luna-server"],
  "environment": {
    "LUNA_BIND_HOST": "127.0.0.1",
    "LUNA_PORT": "9870",
    "RUST_LOG": "luna_server=info,luna_pi=info"
  },
  "healthCheck": {
    "url": "http://127.0.0.1:9870/v1/health/ready",
    "timeoutMilliseconds": 5000
  },
  "restart": "on-failure",
  "startAtLogin": true,
  "stopTimeoutSeconds": 30
}
