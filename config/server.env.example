# Copy this file to ~/.config/luna/server.env and set mode 600.
# Never commit the populated file.

LUNA_PUBLIC_ORIGIN=https://your-mac.example.ts.net:8447
LUNA_ALLOWED_TAILNET_LOGINS=you@example.com

# Pi model used once to generate a contextual title for each new conversation.
# LUNA_TITLE_MODEL=openai-codex/gpt-5.6-luna

# OpenAI-compatible speech-to-text. Leave the key empty to disable transcription.
LUNA_TRANSCRIPTION_API_KEY=
LUNA_TRANSCRIPTION_MODEL=gpt-transcribe
# LUNA_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1

# Optional overrides:
# LUNA_DATA_DIR=~/Library/Application Support/Luna Server
# LUNA_EVENT_RETENTION_DAYS=30
# LUNA_ATTACHMENT_RETENTION_DAYS=30
