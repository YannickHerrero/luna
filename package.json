{
  "name": "luna",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --parallel --filter @luna/server --filter @luna/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm --filter @luna/design-tokens generate && pnpm --filter @luna/protocol generate",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.0"
  }
}
