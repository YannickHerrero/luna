{
  "name": "luna",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm build:web && cargo build --release -p luna-server -p luna-tui",
    "build:server": "cargo build --release -p luna-server",
    "build:tui": "cargo build --release -p luna-tui",
    "build:web": "pnpm --filter @luna/protocol build && pnpm --filter @luna/web build",
    "dev": "cargo run -p luna-server",
    "dev:web": "pnpm --filter @luna/web dev",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "generate": "pnpm --filter @luna/design-tokens generate && pnpm --filter @luna/protocol generate && pnpm --filter @luna/web generate:ios-assets",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "pnpm test:verification && pnpm test:web && cargo test --workspace",
    "test:verification": "node --test scripts/verify.test.mjs",
    "test:web": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify": "node scripts/verify.mjs full",
    "verify:code": "node scripts/verify.mjs code"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.0"
  }
}
