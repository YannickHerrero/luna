          },
          "pending": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "String": {
        "type": "string"
      },
      "SyncResponse": {
        "type": "object",
        "required": ["cursor", "events", "resetRequired"],
        "properties": {
          "cursor": {
            "type": "integer",
            "format": "int64"
          },
          "events": {
            "type": "array",
            "items": {}
          },
          "resetRequired": {
            "type": "boolean"
          }
        }
      },
      "TitleMode": {
        "type": "string",
        "enum": ["automatic", "manual"]
      },
      "TranscriptionResponse": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "UpdateConversationRequest": {
        "type": "object",
        "properties": {
          "avatarAttachmentId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "title": {
            "type": ["string", "null"]
          }
        }
      },
      "WorkspaceUpdated": {
        "type": "object",
        "required": ["workingDirectory"],
        "properties": {
          "workingDirectory": {
            "type": "string"
          }
        }
      }
    }
  }
}
