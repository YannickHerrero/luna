                        "type": "boolean"
                      },
                      "icon": {
                        "type": "object",
                        "required": ["repositoryId", "fallbackText", "fallbackColor"],
                        "properties": {
                          "repositoryId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "contentUrl": {
                            "type": "string"
                          },
                          "fallbackText": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 3
                          },
                          "fallbackColor": {
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          }
                        },
                        "additionalProperties": false
                      },
                      "firstSeenAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "lastSeenAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "notificationTargetDeviceId": {
                  "type": "string",
                  "format": "uuid"
                },
                "unreadCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "archivedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "SyncResponse": {
        "type": "object",
        "required": ["cursor", "events", "resetRequired"],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {}
          },
          "resetRequired": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string",
                "const": "authentication_required"
              },
              {
                "type": "string",
                "const": "forbidden"
              },
              {
                "type": "string",
                "const": "invalid_request"
              },
              {
                "type": "string",
                "const": "not_found"
              },
              {
                "type": "string",
                "const": "conflict"
              },
              {
                "type": "string",
                "const": "agent_unavailable"
              },
              {
                "type": "string",
                "const": "agent_rejected"
              },
              {
                "type": "string",
                "const": "attachment_invalid"
              },
              {
                "type": "string",
                "const": "transcription_failed"
              },
              {
                "type": "string",
                "const": "rate_limited"
              },
              {
                "type": "string",
                "const": "internal_error"
              }
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "retryable": {
            "type": "boolean"
          },
          "requestId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
