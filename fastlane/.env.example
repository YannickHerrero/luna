# App Store Connect API key metadata. Keep real values in ignored fastlane/.env.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional; defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_PATH=
# Non-secret team metadata remains local because signing teams are developer-specific.
APPLE_TEAM_ID=
# Optional text shown to internal TestFlight testers.
TESTFLIGHT_CHANGELOG=Initial Luna beta with iPhone, iPad, widget, and Apple Watch placeholders.
