{
  "name": "@luna/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:icons && next build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dev": "next dev",
    "test": "vitest run --exclude e2e/**",
    "test:e2e": "pnpm build && cargo build --manifest-path ../../Cargo.toml -p luna-server && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@luna/design-tokens": "workspace:*",
    "@luna/protocol": "workspace:*",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "sharp": "^0.34.5"
  }
}
